{
  "name": "reader-panghu",
  "version": "1.1.12",
  "private": true,
  "description": "Unified reading server: Legado/闃呰3 book sources, WebView book-source runtime, multi-device progress sync",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node apps/server/src/index.js",
    "dev": "node --watch apps/server/src/index.js",
    "test": "node --test packages/*/test/*.test.js apps/server/test/*.test.js",
    "probe": "node scripts/probe-source.js",
    "verify": "node scripts/check-docker.mjs && node scripts/run-all-tests.mjs",
    "verify:tests": "node scripts/run-all-tests.mjs"
  },
  "packageManager": "pnpm@11.28.5",
  "devDependencies": {
    "fflate": "^0.8.2"
  }
}
